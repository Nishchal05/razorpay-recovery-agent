# ==============================================================================
# RECOVERY AGENT SERVER - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit your real .env file with secrets into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL / Neon with pgvector)
# ------------------------------------------------------------------------------
# PostgreSQL connection string used by Prisma ORM and the application backend.
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI / LLM
# ------------------------------------------------------------------------------
# Google Gemini API key used for LangChain Google GenAI reasoning and recovery agents.
GOOGLE_API_KEY=""

# ------------------------------------------------------------------------------
# 3. META WHATSAPP CLOUD API
# ------------------------------------------------------------------------------
# Permanent / System User Access Token from Meta Developer Portal
META_ACCESS_TOKEN=""

# WhatsApp Business Phone Number ID
META_PHONE_NUMBER_ID=""

# Meta Graph API version (default: v25.0)
META_API_VERSION="v25.0"

# Secret verification token for WhatsApp Webhook verification in Meta App Dashboard
META_VERIFY_TOKEN=""

# Default language code for WhatsApp message templates (e.g., en, en_US)
WA_TEMPLATE_LANG="en"

# URL prefix for dynamic button payment links (e.g., https://rzp.io/)
WA_BUTTON_URL_PREFIX="https://rzp.io/"

# WhatsApp Template Names configured in Meta WhatsApp Manager
WA_TEMPLATE_PAYMENT_REMINDER="payment_reminder"
WA_TEMPLATE_PROMISE_FOLLOWUP="payment_reminder"
WA_TEMPLATE_OVERDUE_REMINDER="payment_reminder"
WA_TEMPLATE_GENERAL_FOLLOWUP="payment_reminder"
WA_TEMPLATE_INVOICE_PAYMENT="invoice_payment"

# ------------------------------------------------------------------------------
# 4. GMAIL API & GOOGLE CLOUD OAUTH2
# ------------------------------------------------------------------------------
# OAuth 2.0 Web Client credentials from Google Cloud Console
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REDIRECT_URI="http://127.0.0.1:8000/auth/gmail/callback"

# Optional fallback aliases
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://127.0.0.1:8000/auth/gmail/callback"

# Optional: Default sender email address and token storage file
GMAIL_FROM_ADDRESS=""
# GMAIL_TOKEN_FILE="gmail_token.json"

# ------------------------------------------------------------------------------
# 5. RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Razorpay API Key ID and Secret from Razorpay Dashboard
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Secret configured for Razorpay Webhooks (payment.captured, payment_link.paid)
RAZORPAY_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 6. ELEVENLABS CONVERSATIONAL AI (VOICE AGENT)
# ------------------------------------------------------------------------------
# ElevenLabs API Key
ELEVENLABS_API_KEY=""

# Conversational AI Agent ID
ELEVENLABS_AGENT_ID=""

# ElevenLabs Assigned Phone Number ID for inbound/outbound calls
ELEVENLABS_PHONE_NUMBER_ID=""

# Secret configured for post-call ElevenLabs Webhook verification
ELEVENLABS_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 7. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JWT tokens
JWT_SECRET=""
JWT_ALGORITHM="HS256"
