# Database
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"

# Google Gemini LLM
GOOGLE_API_KEY=your_gemini_api_key_here

# Meta WhatsApp Cloud API
META_ACCESS_TOKEN=your_meta_access_token_here
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here
META_API_VERSION=v25.0
META_VERIFY_TOKEN=your_meta_webhook_verify_token_here
WA_TEMPLATE_LANG=en_US

# Gmail API (OAuth2)
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_REDIRECT_URI=http://localhost:8000/auth/gmail/callback
GMAIL_FROM_ADDRESS=your_email@example.com

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ElevenLabs Conversational AI (Voice Agent "JEA")
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here
ELEVENLABS_PHONE_NUMBER_ID=your_elevenlabs_phone_number_id_here
ELEVENLABS_WEBHOOK_SECRET=your_elevenlabs_webhook_secret_here

# Auth JWT Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
