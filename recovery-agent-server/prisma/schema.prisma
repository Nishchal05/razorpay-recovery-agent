generator client {
  provider                    = "prisma-client-py"
  interface                   = "asyncio"
  previewFeatures             = ["postgresqlExtensions"]
  enable_experimental_decimal = true
  recursive_type_depth        = -1
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}


// -------------------------
// ENUMS
// -------------------------

enum InvoiceStatus {
  PENDING
  DISPUTE
  PAID
}

enum MessageType {
  RECEIVED
  SENT
}


// -------------------------
// COMPANY
// -------------------------

enum PreferredChannel {
  WHATSAPP
  EMAIL
  VOICE_CALL
}

model Company {
  company_id       Int              @id @default(autoincrement())
  company_name     String           @unique
  company_address  String
  company_phone    String           @unique
  company_email    String           @unique

  preferred_channel PreferredChannel @default(WHATSAPP)

  invoices         Invoice[]
  history          CompanyHistory?

  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
}
// -------------------------
// COMPANY HISTORY / PROFILE
// -------------------------

model CompanyHistory {
  id         Int      @id @default(autoincrement())

  company_id Int      @unique
  company    Company  @relation(fields: [company_id], references: [company_id], onDelete: Cascade)

  // AI-generated company profile
  history    Json

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}


// -------------------------
// INVOICE
// -------------------------

model Invoice {
  invoice_id            Int           @id @default(autoincrement())
  invoice_name          String

  invoice_due_date      DateTime
  invoice_amount        Decimal       @db.Decimal(12, 2)

  invoice_amount_status Boolean       @default(false)
  invoice_status        InvoiceStatus @default(PENDING)

  company_id            Int
  company               Company       @relation(fields: [company_id], references: [company_id], onDelete: Cascade)

  messages              Message[]

  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt

  @@index([company_id])
  @@index([invoice_due_date])
  @@index([invoice_status])
}


// -------------------------
// MESSAGE
// -------------------------

model Message {
  message_id    Int       @id @default(autoincrement())

  content       String
  message_type MessageType

  // pgvector embedding
  embedding     Unsupported("vector(1536)")

  invoice_id   Int
  invoice      Invoice   @relation(fields: [invoice_id], references: [invoice_id], onDelete: Cascade)

  created_at    DateTime  @default(now())

  @@index([invoice_id])
}