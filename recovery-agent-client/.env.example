# ==============================================================================
# RECOVERY AGENT CLIENT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and fill in your actual settings.
# ==============================================================================

# Backend API Base URL (FastAPI Server)
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Set to "true" to bypass frontend authentication during development
NEXT_PUBLIC_AUTH_BYPASS="false"

# Integration status flags (used for UI badge indications)
NEXT_PUBLIC_META_CONFIGURED="true"
NEXT_PUBLIC_RAZORPAY_CONFIGURED="true"
NEXT_PUBLIC_ELEVENLABS_CONFIGURED="true"
